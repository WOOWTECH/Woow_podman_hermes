# PostgreSQL 15 for the Hermes stack (parity with the compose stack). No host port: only reachable on
# the hermes network, so it cannot collide with a host that already uses 127.0.0.1:5432.
[Unit]
Description=Woow Hermes PostgreSQL 15
Documentation=https://github.com/WOOWTECH/Woow_podman_hermes

[Container]
ContainerName=hermes-postgresql
Image=docker.io/library/postgres:15.19@sha256:9b1d34adbce1dd07ee6e94b4a2cf698884b89bd44a6c9c12f5da8f3acbfe4957
Network=hermes.network
HostName=hermes-postgresql
Label=io.woowtech.stack=hermes
Volume=hermes-postgres-data.volume:/var/lib/postgresql/data
Environment=POSTGRES_DB=hermes
Environment=POSTGRES_USER=hermes
Environment=PGDATA=/var/lib/postgresql/data/pgdata
# The entrypoint reads the *_FILE variant, so the password never sits in the container config.
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
Secret=hermes-postgres-password,type=mount,target=postgres_password,uid=999,gid=999,mode=0400
HealthCmd=pg_isready -U hermes -d hermes
HealthInterval=10s
HealthTimeout=5s
HealthRetries=6
HealthStartPeriod=20s
NoNewPrivileges=true
PodmanArgs=--stop-timeout=60

[Service]
# A container stopped by systemd is stopped with SIGTERM: an entrypoint that does not
# trap it exits 143 (128+15), which would leave the unit failed after a clean stop.
SuccessExitStatus=143
Restart=always
TimeoutStartSec=600
TimeoutStopSec=90

[Install]
WantedBy=default.target
