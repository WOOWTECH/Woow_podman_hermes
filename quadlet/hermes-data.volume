# HERMES_HOME: SQLite state, sessions, skills, memories, ui-tui copy, playwright browsers.
# A legacy compose host copies podman_hermes-data into this volume (scripts/migrate-legacy.sh) and
# keeps the old volume untouched for rollback.
[Unit]
Description=Woow Hermes data volume (/opt/data)

[Volume]
VolumeName=hermes-data
Label=io.woowtech.stack=hermes
