# ~/.config/hermes/hermes.env - installed by scripts/install.sh with mode 0600 and passed to
# hermes-agent through EnvironmentFile= (no '-' prefix: the file must exist).
#
# Rules: KEY=value, no quotes, no inline "# comments" after a value (podman --env-file keeps them).
# Generated secrets are NOT here; install.sh keeps them in podman secrets:
#   hermes-api-server-key, hermes-webhook-secret, hermes-dashboard-password,
#   hermes-dashboard-session-secret, hermes-postgres-password
# Read one back with: podman secret inspect --showsecret --format '{{.SecretData}}' <name>
#
# The keys below are user-supplied. The in-image cont-init hook 03-woow-dotenv copies MINIMAX_API_KEY,
# OPENROUTER_API_KEY and GITHUB_TOKEN into /opt/data/.env (mode 0600), because the dashboard TUI reads
# that file rather than the process environment. A key is copied only when its value here changed
# since the last start, so a key edited in the dashboard is kept; an empty value copies nothing.

# Public URL of the dashboard: the exact origin your browser opens it from. MCP OAuth callbacks go
# here, and the Paseo plugin accepts browser requests only from this origin (plus the extra one
# below). Keep both lines identical. Behind an HTTPS reverse proxy or tunnel use its origin, e.g.
# https://hermes.example.com: scheme and host (and a port only if it is not the default), no path,
# no trailing slash. The loopback dashboard (http://127.0.0.1:19119) keeps working either way.
HERMES_DASHBOARD_PUBLIC_URL=http://localhost:19119
HERMES_BASE_URL=http://localhost:19119
# Optional second exact browser origin for the Paseo plugin (scheme://host[:port], no path), e.g. the
# loopback http://127.0.0.1:19119 when the public URL above is an HTTPS tunnel. Leave empty when the
# dashboard is only opened from the public URL. localhost and 127.0.0.1 are different origins.
HERMES_PASEO_EXTRA_ORIGIN=

# LLM providers. MINIMAX_API_KEY is required unless install.sh is run with --no-llm.
MINIMAX_API_KEY=
OPENROUTER_API_KEY=
# Raises the skills-hub rate limit (60/h -> 5000/h). No scopes needed.
GITHUB_TOKEN=
# MCP_BROWSERLESS_MCP_API_KEY=

# --- installer knobs (read by scripts/install.sh; hermes ignores them) ---
WOOW_HERMES_BIND=127.0.0.1
WOOW_HERMES_PORT_GATEWAY=18642
WOOW_HERMES_PORT_DASHBOARD=19119
WOOW_HERMES_PORT_WEBHOOK=18644
WOOW_HERMES_MEMORY=6g
WOOW_HERMES_CPUS=3
# slim (default) = the upstream image plus exactly what the old deploy.sh did to the running
# container. full = slim plus the never-used 7-layer toolchain (see container/Containerfile).
WOOW_HERMES_IMAGE_TARGET=slim
# CPUs the image build may use (podman build --cpuset-cpus), so a build does not starve the host.
WOOW_HERMES_BUILD_CPUS=
# Names of the three podman volumes. Leave the defaults on a new host. scripts/migrate-legacy.sh
# sets them to the compose-era names (podman_hermes-data, podman_postgres-data, podman_redis-data)
# so an existing deployment is adopted in place instead of copied. Changing one on a running host
# points the stack at a different (probably empty) volume.
WOOW_HERMES_DATA_VOLUME=hermes-data
WOOW_HERMES_POSTGRES_VOLUME=hermes-postgres-data
WOOW_HERMES_REDIS_VOLUME=hermes-redis-data
