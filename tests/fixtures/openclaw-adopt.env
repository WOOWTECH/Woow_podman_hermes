# tests/fixtures/openclaw-adopt.env: what scripts/migrate-legacy.sh writes on woowtechopenclaw -
# the compose-era volume names, so the three podman_* volumes are adopted where they are, and the
# ports and 0.0.0.0 bind the compose stack published. Renders in CI so the adoption path is
# checked by the Quadlet generator, not only by the migration script.
# ~/.config/hermes/hermes.env - installed by scripts/install.sh with mode 0600 and passed to
# hermes-agent through EnvironmentFile= (no '-' prefix: the file must exist).
#
# Rules: KEY=value, no quotes, no inline "# comments" after a value (podman --env-file keeps them).
# Generated secrets are NOT here; install.sh keeps them in podman secrets:
#   hermes-api-server-key, hermes-webhook-secret, hermes-dashboard-password, hermes-postgres-password
# Read one back with: podman secret inspect --showsecret --format '{{.SecretData}}' <name>
#
# The keys below are user-supplied. The in-image cont-init hook copies MINIMAX_API_KEY and
# OPENROUTER_API_KEY into /opt/data/.env (mode 0600) on every start, because the dashboard TUI reads
# that file rather than the process environment.

# Public URL of the dashboard, used for MCP OAuth callbacks. Keep both lines identical.
HERMES_DASHBOARD_PUBLIC_URL=https://woow-openclaw-services-1.example.ts.net
HERMES_BASE_URL=https://woow-openclaw-services-1.example.ts.net

# LLM providers. MINIMAX_API_KEY is required unless install.sh is run with --no-llm.
MINIMAX_API_KEY=
OPENROUTER_API_KEY=
# Raises the skills-hub rate limit (60/h -> 5000/h). No scopes needed.
GITHUB_TOKEN=
# MCP_BROWSERLESS_MCP_API_KEY=

# --- installer knobs (read by scripts/install.sh; hermes ignores them) ---
WOOW_HERMES_BIND=all
WOOW_HERMES_PORT_GATEWAY=18642
WOOW_HERMES_PORT_DASHBOARD=19119
WOOW_HERMES_PORT_WEBHOOK=18644
WOOW_HERMES_MEMORY=6g
WOOW_HERMES_CPUS=3
# slim (default) = the upstream image plus exactly what the old deploy.sh did to the running
# container. full = slim plus the never-used 7-layer toolchain (see container/Containerfile).
WOOW_HERMES_IMAGE_TARGET=slim
# CPUs the image build may use (podman build --cpuset-cpus), so a build does not starve the host.
WOOW_HERMES_BUILD_CPUS=
WOOW_HERMES_DATA_VOLUME=podman_hermes-data
WOOW_HERMES_POSTGRES_VOLUME=podman_postgres-data
WOOW_HERMES_REDIS_VOLUME=podman_redis-data
