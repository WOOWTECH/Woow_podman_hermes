#!/command/with-contenv bash
# shellcheck shell=bash
# Boot-time provisioning of /opt/data (runs as container root before s6 starts the services). The
# same script as the Home Assistant add-on's (container/patches/PROVENANCE). Replaces deploy.sh steps
# 7 and 10; the .env half of step 8 is 03-woow-dotenv. Idempotent; never touches files outside
# /opt/data.
set -euo pipefail
DATA=/opt/data
STAMP="$DATA/.woow-image-version"

refuse_symlink() { if [[ -L $1 ]]; then echo "[woow-provision] refusing to write through symlink $1" >&2; exit 1; fi; }

# Step 10: caches that embed the previous image's catalog.
if [[ "$(cat "$STAMP" 2>/dev/null || true)" != "${WOOW_IMAGE_VERSION:-dev}" ]]; then
    rm -f "$DATA/.skills_prompt_snapshot.json" "$DATA/skills/.bundled_manifest" \
          "$DATA/provider_models_cache.json" "$DATA/models_dev_cache.json"
    # 0.20.0 ran the TUI from a copy in /opt/data/ui-tui (HERMES_TUI_DIR). v0.22.5 runs it from the
    # root-owned image tree, so the copy is stale. A rollback to 0.20.0 copies it back.
    if [[ -d $DATA/ui-tui && ! -L $DATA/ui-tui ]]; then rm -rf "$DATA/ui-tui"; fi
    refuse_symlink "$STAMP"
    printf '%s\n' "${WOOW_IMAGE_VERSION:-dev}" >"$STAMP"
    chown hermes:hermes "$STAMP"
fi

# Step 7: seed the pinned superpowers skills only when the user has none of them yet.
if [[ ! -f "$DATA/skills/brainstorming/SKILL.md" ]]; then
    refuse_symlink "$DATA/skills"
    mkdir -p "$DATA/skills"
    cp -a /opt/woow/seed/skills/. "$DATA/skills/"
    chown -R hermes:hermes "$DATA/skills"
fi
